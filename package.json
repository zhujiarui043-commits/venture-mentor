{
  "name": "venture-mentor-team-test",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "test:logic": "node tests/mentor-logic.mjs",
    "test:interview-hypotheses": "node tests/interview-hypotheses.mjs",
    "test:diagnosis": "node tests/diagnosis-scoring.mjs",
    "test:diagnosis-ui": "node tests/diagnosis-scoring-ui.mjs",
    "test:search": "node tests/competitor-search.mjs",
    "test:retention-ui": "node tests/competitor-retention-ui.mjs",
    "test:numbering-ui": "node tests/record-numbering-ui.mjs",
    "test:materials": "node tests/word-material.mjs",
    "test:records": "node tests/analysis-records.mjs",
    "test:word-export-ui": "node tests/word-export-production.mjs",
    "test:panel": "node tests/mentor-panel.mjs",
    "test:markdown": "node tests/message-content.mjs",
    "test:deploy-config": "node tests/deployment-config.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-login.mjs local",
    "db:migrate:remote": "node scripts/migrate-login.mjs remote",
    "test:redesign-ui": "node tests/redesign-ui.mjs",
    "test:research-ui": "node tests/research-workspace-ui.mjs",
    "test:text-layout-ui": "node tests/text-layout-ui.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.13.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
